# Copy to .env.local (or set in your host's build settings) and fill in
# whatever you have. Anything left empty simply stays hidden on the site.

# Canonical origin, no trailing slash.
VITE_SITE_URL=https://takepause.in

# Google Apps Script web app URL (ends in /exec). Saves enquiries to a Google
# Sheet and reference photos to Drive. Setup: backend/google-apps-script/README.md
VITE_ENQUIRY_ENDPOINT=

# Verified WhatsApp business number, international format, digits only.
# Example shape: 91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Public email address.
VITE_CONTACT_EMAIL=

# JSON feed of recent Instagram posts (e.g. from behold.so).
VITE_INSTAGRAM_FEED_URL=
